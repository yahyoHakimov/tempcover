# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://tempcover:tempcover@db:5432/tempcover

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ──────────────────────────────────────────────────
ENVIRONMENT=production
APP_URL=https://tempcover-verify.com
CORS_ORIGINS=https://tempcover-verify.com,https://www.tempcover-verify.com
STATIC_DIR=/app/static

# ── Email (Brevo). Leave BREVO_API_KEY empty to print emails to the log instead of sending.
BREVO_API_KEY=
FROM_EMAIL=noreply@tempcover-verify.com
FROM_NAME=TempCover Insurance
SUPPORT_EMAIL=support@tempcover-verify.com

# ── First-run seed (python seed.py). Empty password = no super admin is created.
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL=admin@tempcover-verify.com
SEED_SUPERADMIN_NAME=TempCover Admin
# Internal "house" agent used when the super admin issues policies directly
HOUSE_TENANT_USERNAME=tempcover-hq

# ── Brand / legal identity (emails + PDF footers). Blank = line omitted.
TRADING_NAME=TempCover
COMPANY_LEGAL_NAME=TempCover Ltd
COMPANY_REG_NO=
REGISTERED_OFFICE=
FCA_FRN=
UNDERWRITER_NAME=
UNDERWRITER_FRN=
POLICY_NUMBER_PREFIX=TCV-MOT-

# ── Lifecycle jobs: pending→active, expiry, 24h driver reminder, daily agent digest (0 = off)
LIFECYCLE_TICK_SECONDS=60
REMINDER_HOURS_BEFORE_EXPIRY=24
AGENT_DIGEST_HOUR_UTC=8
AGENT_DIGEST_DAYS_AHEAD=3
